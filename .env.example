# Local Worker secrets for `pnpm dev`. Copy to .env and generate a key with: openssl rand -hex 32
# Remote Worker secrets live in .env.cloudflare-staging / .env.cloudflare-production (uploaded with
# `wrangler secret bulk`). Never put a Cloudflare API token in these files. See docs/deployment.md.
# Never name a file .env.production, .env.development or .env.local: Vite loads those into every build.
EMDASH_ENCRYPTION_KEY=replace-with-a-generated-local-key
# Stripe: claves de prueba en .env.cloudflare-staging y reales en .env.cloudflare-production.
# Nunca guardar valores reales en este ejemplo; ver docs/checkout.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publish-triggered rebuilds (phase 6, docs/deployment.md) run only on staging/production;
# local development never dispatches. Remote: wrangler secret put GITHUB_REBUILD_TOKEN --env <env>.
