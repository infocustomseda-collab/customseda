{
  "name": "custom-seda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Custom Seda",
    "seed": "seed/foundation.json"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build/snapshot.mjs --env local --allow-empty && node scripts/build/images.mjs --env local && node scripts/build/prerender-db.mjs local && astro build && node scripts/build/check-static.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "wrangler types && astro check",
    "cf:types": "wrangler types",
    "cf:whoami": "wrangler whoami",
    "test": "node --test tests/*.test.mjs",
    "deploy:staging": "node scripts/deploy/run.mjs staging",
    "deploy:production": "node scripts/deploy/run.mjs production",
    "migrate:status": "node scripts/deploy/status.mjs",
    "build:staging": "CLOUDFLARE_ENV=staging astro build",
    "build:production": "CLOUDFLARE_ENV=production astro build",
    "cms:model": "node scripts/cms/apply-local-model.mjs",
    "cms:model:remote": "node scripts/cms/apply-remote-model.mjs",
    "test:d1": "node --test tests/integration/*.test.mjs",
    "import:shopify": "node scripts/import/shopify-local.mjs",
    "import:shopify:verify": "node scripts/import/shopify-verify.mjs",
    "import:pages": "node scripts/import/restore-page-structure.mjs",
    "design:fluid": "node scripts/design/fluid-scale.mjs",
    "cms:storefront": "node scripts/cms/storefront-content.mjs",
    "snapshot": "node scripts/build/snapshot.mjs",
    "design:open-props": "node scripts/design/open-props.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "7.1.1",
    "@emdash-cms/cloudflare": "1.3.1",
    "@fontsource/cormorant": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "kysely": "0.29.7",
    "open-props": "1.7.23",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "kysely-d1": "0.4.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "wrangler": "4.152.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.4 <27",
    "pnpm": ">=11.9.0 <12"
  }
}
