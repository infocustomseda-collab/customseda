          "label": "Texto de portada",
          "type": "text"
        },
        {
          "slug": "hero_image",
          "label": "Imagen de portada",
          "type": "image"
        },
        {
          "slug": "hero_link",
          "label": "Enlace de portada",
          "type": "url"
        },
        {
          "slug": "contact_email",
          "label": "Email de contacto",
          "type": "string"
        },
        {
          "slug": "instagram_url",
          "label": "Instagram",
          "type": "url"
        },
        {
          "slug": "production_text",
          "label": "Información de producción",
          "type": "portableText"
        }
      ]
    },
