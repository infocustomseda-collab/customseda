          "searchable": true
        },
        {
          "slug": "enabled",
          "label": "Activo",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "slug": "content",
          "label": "Contenido",
          "type": "portableText"
        },
        {
          "slug": "image",
          "label": "Imagen",
          "type": "image"
        },
        {
          "slug": "button_text",
