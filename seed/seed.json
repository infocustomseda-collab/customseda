{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Custom Seda catalog v1",
    "description": "Made-to-order products, optional bundles, and native hierarchical categories. No inventory."
  },
  "collections": [
    {
      "slug": "products",
      "label": "Productos",
      "labelSingular": "Producto",
      "routable": true,
      "sortOrder": 10,
      "group": "Catálogo",
      "supports": [
        "drafts",
        "revisions",
        "scheduling",
        "seo"
      ],
      "urlPattern": "/products/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Título",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "description",
          "label": "Descripción",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "summary",
          "label": "Descripción breve",
          "type": "text"
        },
        {
          "slug": "gallery",
          "label": "Imágenes — arrastra para ordenar; la primera es la principal",
          "type": "repeater",
          "validation": {
            "maxItems": 24,
            "subFields": [
              {
                "slug": "image",
                "label": "Imagen",
                "type": "image",
                "required": true
              },
              {
                "slug": "alt",
                "label": "Texto alternativo",
                "type": "string",
                "required": true
              },
              {
                "slug": "focal_x",
                "label": "Punto focal horizontal (0–1)",
                "type": "number",
                "validation": {
                  "min": 0,
                  "max": 1
                }
              },
              {
                "slug": "focal_y",
                "label": "Punto focal vertical (0–1)",
                "type": "number",
                "validation": {
                  "min": 0,
                  "max": 1
                }
              }
            ]
          }
        },
        {
          "slug": "price_cents",
          "label": "Precio en céntimos EUR (ej. 5900 = 59 €)",
          "type": "integer",
          "required": true,
          "validation": {
            "min": 0
          }
        },
        {
          "slug": "available",
          "label": "Disponible",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "slug": "collection",
          "label": "Colección",
          "type": "reference",
          "required": false,
          "validation": {
            "targetCollection": "collections",
            "multiple": false
          }
        },
        {
          "slug": "color",
          "label": "Color",
          "type": "reference",
          "required": false,
          "validation": {
            "targetCollection": "colors",
            "multiple": false
          }
        },
        {
          "slug": "sizes",
          "label": "Tallas disponibles",
          "type": "reference",
          "required": false,
          "validation": {
            "targetCollection": "sizes",
            "multiple": true
          }
        },
        {
          "slug": "size_guide",
          "label": "Guía de tallas",
          "type": "reference",
          "required": false,
          "validation": {
            "targetCollection": "size_guides",
            "multiple": false
          }
        },
        {
          "slug": "bundle",
          "label": "Producto en conjunto (Bundle product)",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "slug": "components",
          "label": "Productos incluidos — selecciona al menos dos",
          "type": "reference",
          "required": false,
          "validation": {
            "targetCollection": "products",
            "multiple": true
          }
        }
      ]
    },
    {
      "slug": "collections",
      "label": "Colecciones",
      "labelSingular": "Colección",
      "routable": false,
      "sortOrder": 40,
      "group": "Catálogo",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Título",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "code",
          "label": "Código estable",
          "type": "string",
          "required": true,
          "unique": true,
          "indexed": true
        },
        {
          "slug": "description",
          "label": "Historia de la colección",
          "type": "portableText"
        },
        {
          "slug": "image",
          "label": "Imagen",
          "type": "image"
        }
      ]
    },
    {
      "slug": "sizes",
      "label": "Tallas",
      "labelSingular": "Talla",
      "routable": false,
      "sortOrder": 50,
      "group": "Catálogo",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Título (talla · categoría)",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "label",
          "label": "Etiqueta (talla visible en la tienda)",
          "type": "string",
          "required": true
        },
        {
          "slug": "sort_order",
          "label": "Orden",
          "type": "integer"
        }
      ]
    },
    {
      "slug": "colors",
      "label": "Colores",
      "labelSingular": "Color",
      "routable": false,
      "sortOrder": 60,
      "group": "Catálogo",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Título",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "hex",
          "label": "Color hexadecimal",
          "type": "string",
          "validation": {
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      ]
    },
    {
      "slug": "materials",
      "label": "Materiales",
      "labelSingular": "Material",
      "routable": false,
      "sortOrder": 65,
      "group": "Catálogo",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Nombre",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "color",
          "label": "Color",
          "type": "reference",
          "required": false,
          "validation": {
            "targetCollection": "colors",
            "multiple": false
          }
        },
        {
          "slug": "sizes",
          "label": "Disponibilidad",
          "type": "reference",
          "required": false,
          "validation": {
            "targetCollection": "sizes",
            "multiple": true
          }
        },
        {
          "slug": "special_edition",
          "label": "Edición especial",
          "type": "boolean",
          "defaultValue": false
        }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ],
      "sortOrder": 70
    },
    {
      "slug": "size_guides",
      "label": "Guías de tallas",
      "labelSingular": "Guía de tallas",
      "routable": false,
      "sortOrder": 80,
      "group": "Contenido",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Título",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Guía y medidas",
          "type": "portableText"
        }
      ]
    },
