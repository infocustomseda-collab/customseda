        },
        {
          "slug": "button_url",
          "label": "Enlace del botón",
          "type": "url"
        },
        {
          "slug": "starts_at",
          "label": "Mostrar desde",
          "type": "datetime"
        },
        {
          "slug": "ends_at",
          "label": "Mostrar hasta",
          "type": "datetime"
        },
        {
          "slug": "delay_seconds",
          "label": "Retraso en segundos",
          "type": "integer",
          "defaultValue": 3,
          "validation": {
            "min": 0
          }
        },
        {
          "slug": "dismiss_days",
          "label": "Días hasta volver a mostrar",
          "type": "integer",
          "defaultValue": 7,
          "validation": {
            "min": 0
          }
        }
      ]
    },
    {
      "slug": "shipping_rules",
      "label": "Configuración de envío",
      "labelSingular": "Regla de envío",
      "routable": false,
      "sortOrder": 110,
      "group": "Contenido",
      "supports": [
        "drafts",
        "revisions"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Título",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "enabled",
          "label": "Activa",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "slug": "zone",
          "label": "Zona",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "canarias",
              "peninsula_baleares",
              "international",
              "pickup"
            ]
          }
        },
        {
          "slug": "country_codes",
          "label": "Países (ISO separados por coma)",
          "type": "string"
        },
        {
          "slug": "postal_prefixes",
          "label": "Prefijos postales (separados por coma)",
          "type": "string"
        },
        {
          "slug": "price_cents",
          "label": "Precio de envío en céntimos EUR",
          "type": "integer",
          "required": true,
          "validation": {
            "min": 0
          }
        },
        {
          "slug": "free_above_cents",
          "label": "Envío gratis desde (céntimos EUR)",
          "type": "integer",
          "validation": {
            "min": 0
          }
        },
        {
          "slug": "description",
          "label": "Plazos y condiciones",
          "type": "text"
        }
      ]
    }
  ],
