{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customseda-local",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "EMDASH_SITE_URL": "http://localhost:4321",
    "FOUNDATION_LOCKED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customseda-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "customseda-local-media"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "customseda-staging",
      "workers_dev": true,
      "assets": {
        "run_worker_first": true
      },
      "vars": {
        "EMDASH_SITE_URL": "https://customseda-staging.customseda.workers.dev",
        "FOUNDATION_LOCKED": "true",
        "SITE_ROLE": "public",
        "PREVIEW_SITE_URL": "https://customseda-staging-preview.customseda.workers.dev"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "customseda-staging",
          "database_id": "8c279b51-3653-400f-a02c-408acb52569f"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "customseda-staging-media"
        }
      ]
    },
    "staging-preview": {
      "name": "customseda-staging-preview",
      "workers_dev": true,
      "assets": {
        "run_worker_first": true
      },
      "vars": {
        "EMDASH_SITE_URL": "https://customseda-staging-preview.customseda.workers.dev",
        "FOUNDATION_LOCKED": "true",
        "SITE_ROLE": "preview",
        "PUBLIC_SITE_URL": "https://customseda-staging.customseda.workers.dev",
        "DEPLOY_ENVIRONMENT": "staging",
        "GITHUB_REPOSITORY": "infocustomseda-collab/customseda"
      },
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "customseda-staging",
          "database_id": "8c279b51-3653-400f-a02c-408acb52569f"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "customseda-staging-media"
        }
      ]
    },
    "production": {
      "name": "customseda-production",
      "workers_dev": true,
      "assets": {
        "run_worker_first": true
      },
      "vars": {
        "EMDASH_SITE_URL": "https://customseda-production.customseda.workers.dev",
        "FOUNDATION_LOCKED": "true",
        "SITE_ROLE": "public",
        "PREVIEW_SITE_URL": "https://customseda-production-preview.customseda.workers.dev"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "customseda-production",
          "database_id": "ef91b5bb-deb3-4984-93ee-83b2df4e5083"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "customseda-production-media"
        }
      ]
    },
    "production-preview": {
      "name": "customseda-production-preview",
      "workers_dev": true,
      "assets": {
        "run_worker_first": true
      },
      "vars": {
        "EMDASH_SITE_URL": "https://customseda-production-preview.customseda.workers.dev",
        "FOUNDATION_LOCKED": "true",
        "SITE_ROLE": "preview",
        "PUBLIC_SITE_URL": "https://customseda-production.customseda.workers.dev",
        "DEPLOY_ENVIRONMENT": "production",
        "GITHUB_REPOSITORY": "infocustomseda-collab/customseda"
      },
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "customseda-production",
          "database_id": "ef91b5bb-deb3-4984-93ee-83b2df4e5083"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "customseda-production-media"
        }
      ]
    }
  },
  "account_id": "9e52d6bc1e5b9be5cd11be4c1030485a"
}
