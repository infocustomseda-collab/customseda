{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customseda-local",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "EMDASH_SITE_URL": "http://localhost:4321",
    "FOUNDATION_LOCKED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customseda-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "customseda-local-media"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "customseda-staging",
      "workers_dev": true,
      "vars": {
        "EMDASH_SITE_URL": "https://customseda-staging.customseda.workers.dev",
        "CMS_ORIGIN": "https://customseda.customseda.workers.dev",
        "FOUNDATION_LOCKED": "true",
        "SITE_ROLE": "preview"
      },
      "assets": {
        "run_worker_first": true
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "f182e3b1d1124efcaee5621f17efe31b"
        }
      ],
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "customseda-production",
          "database_id": "ef91b5bb-deb3-4984-93ee-83b2df4e5083"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "customseda-production-media"
        }
      ]
    },
    "production": {
      "name": "customseda",
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_destination_addresses": [
            "87c21@live.it",
            "info.customseda@gmail.com"
          ]
        }
      ],
      "workers_dev": true,
      "vars": {
        "EMDASH_SITE_URL": "https://customseda.customseda.workers.dev",
        "FOUNDATION_LOCKED": "false",
        "SITE_ROLE": "public",
        "SSR_PREVIEW_URL": "https://customseda-staging.customseda.workers.dev",
        "DEPLOY_ENVIRONMENT": "production",
        "GITHUB_REPOSITORY": "infocustomseda-collab/customseda"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "f182e3b1d1124efcaee5621f17efe31b"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "customseda-production",
          "database_id": "ef91b5bb-deb3-4984-93ee-83b2df4e5083"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "customseda-production-media"
        }
      ]
    }
  },
  "account_id": "9e52d6bc1e5b9be5cd11be4c1030485a"
}
