---
// Public storefront layout. Purely presentational: pages pass the site chrome as props, so the
// same markup serves live development data now and the build-time snapshot in phase 6.
import { Font } from "astro:assets";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import PreviewBanner from "../components/PreviewBanner.astro";
import PageTransitions from "../components/PageTransitions.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SitePopup from "../components/SitePopup.astro";
import UpdateBanner from "../components/UpdateBanner.astro";
import type { PopupView } from "../lib/shop/site";
import type { NavItem, SocialLink } from "../lib/shop/view";
import "../styles/index.css";

export type SiteChrome = {
	siteName: string;
	nav: NavItem[];
	footerLinks: NavItem[];
	social: SocialLink[];
	announcement?: { text: string; href?: string } | null;
	popups?: PopupView[];
};

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	image?: string;
	noindex?: boolean;
	site: SiteChrome;
}

const { title, description, canonical, image, noindex, site } = Astro.props;
const fullTitle = title === site.siteName ? title : `${title} — ${site.siteName}`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		{canonical && <link rel="canonical" href={canonical} />}
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="theme-color" content="#fcfcfc" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.siteName} />
		<meta property="og:title" content={fullTitle} />
		{description && <meta property="og:description" content={description} />}
		{image && <meta property="og:image" content={image} />}
		<Font cssVariable="--font-cormorant" preload={[{ weight: 500, style: "normal" }]} />
		<Font cssVariable="--font-montserrat" preload />
		{/* Install before ClientRouter's module: same-catalog history updates its grid. */}
		<script is:inline>
			if (!window.__sedaCatalogHistory) {
				window.__sedaCatalogHistory = true;
				window.addEventListener("popstate", (event) => {
					const catalog = document.querySelector("catalog-browser");
					if (!event.state?.sedaCatalog || !catalog || catalog.dataset.basePath !== location.pathname) return;
					event.stopImmediatePropagation();
					catalog.dispatchEvent(new Event("seda:catalog-history"));
				}, true);
			}
		</script>
		<PageTransitions />
	</head>
	<body>
		<PreviewBanner />
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		{site.announcement?.text && <AnnouncementBar text={site.announcement.text} href={site.announcement.href} />}
		<SiteHeader nav={site.nav} />
		<main id="contenido" tabindex="-1">
			<slot />
		</main>
		<SiteFooter links={site.footerLinks} social={site.social} />
		{site.popups && site.popups.length > 0 && !noindex && <SitePopup popups={site.popups} />}
		{import.meta.env.PROD && <UpdateBanner />}
	</body>
</html>
