---
// "Sobre Seda": the former Shopify blog path, rendered from the "noticias" CMS page.
import ContentPage from "../../components/ContentPage.astro";
import Shop from "../../layouts/Shop.astro";
import { loadShopPage } from "../../lib/shop/page";
import { pageHeading, plainText } from "../../lib/shop/site";

const { shop, site } = await loadShopPage(Astro);
const page = shop.pages.find((entry) => entry.slug === "noticias");
if (!page) return Astro.rewrite("/404");
const heading = pageHeading(site, Astro.url.pathname, String(page.data.title ?? "Sobre Seda"));
---

<Shop title={heading} description={plainText(page.data.content)} site={site}>
	<ContentPage page={page} heading={heading} />
</Shop>
