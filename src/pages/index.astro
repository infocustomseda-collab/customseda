---
// Homepage, assembled from the editable site settings (hero, slideshow, intro, process), plus the latest Conjunto.
import Button from "../components/Button.astro";
import Gallery from "../components/Gallery.astro";
import FeaturedProduct from "../components/home/FeaturedProduct.astro";
import Highlights from "../components/home/Highlights.astro";
import HomeHero from "../components/home/HomeHero.astro";
import RichText from "../components/RichText.astro";
import Shop from "../layouts/Shop.astro";
import { latestConjunto } from "../lib/shop/catalog";
import { byId, loadShopPage } from "../lib/shop/page";
import { localHref, plainText } from "../lib/shop/site";
import { galleryImages, imageView } from "../lib/shop/view";

export const prerender = true;

const { shop, site, settings } = await loadShopPage(Astro);
const data = settings?.data ?? {};
const featured = latestConjunto(shop);
const featuredEntry = byId(shop.products, featured?.id);
const color = shop.colors.find((entry) => entry.slug === featured?.color);
const slides = galleryImages(data.slideshow);
const highlights = (Array.isArray(data.highlights) ? data.highlights : []).flatMap((row: any) =>
	typeof row?.title === "string" && typeof row?.text === "string"
		? [{ title: row.title, text: row.text, image: imageView(row.image, typeof row.alt === "string" ? row.alt : "") }]
		: [],
);
const heroTitle = typeof data.hero_title === "string" && data.hero_title ? data.hero_title : site.siteName;
const heroText = typeof data.hero_text === "string" ? data.hero_text : undefined;
const introTitle = typeof data.intro_title === "string" ? data.intro_title : "";
const collectionLink = localHref(data.hero_link);
---

<Shop title={site.siteName} description={heroText ?? plainText(data.intro_text)} site={site}>
	<HomeHero title={heroTitle} text={heroText} image={imageView(data.hero_image, "")} link={collectionLink} />

	{featured && (
		<FeaturedProduct product={featured.card} color={typeof color?.data.title === "string" ? color.data.title : undefined} description={featuredEntry?.data.description} />
	)}

	{slides.length > 0 && <Gallery images={slides} label="Fotos de campaña de Margarita" variant="slideshow" />}

	{introTitle && (
		<section class="surface-butter region" aria-labelledby="intro-title">
			<div class="wrapper stack text-center" style="--stack-space: var(--space-s)">
				<h2 id="intro-title">{introTitle}</h2>
				<RichText value={data.intro_text} />
			</div>
		</section>
	)}

	<Highlights items={highlights} />

	{/* After the craft story, a way into the catalog so the page does not end on a dead end. */}
	{collectionLink && (
		<p class="wrapper home-cta">
			<Button href={collectionLink} variant="accent">Ver colección</Button>
		</p>
	)}
</Shop>

