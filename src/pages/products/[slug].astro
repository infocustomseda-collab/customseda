---
// Product and Conjunto detail at the existing public path /products/<slug>.
// A Conjunto has its own price and gallery and one size choice per component.
import BuyBox from "../../components/BuyBox.astro";
import Disclosure from "../../components/Disclosure.astro";
import Gallery from "../../components/Gallery.astro";
import Price from "../../components/Price.astro";
import ProductBadges from "../../components/ProductBadges.astro";
import ProductCard from "../../components/ProductCard.astro";
import RichText from "../../components/RichText.astro";
import Shop from "../../layouts/Shop.astro";
import { shippingRules } from "../../lib/commerce/shipping";
import { productDetail } from "../../lib/shop/detail";
import { loadShopContent, loadShopPage } from "../../lib/shop/page";
import { productPaths } from "../../lib/shop/paths";
import { plainText } from "../../lib/shop/site";
import { transitionNames, uniqueTransitions } from "../../lib/shop/view";

export const prerender = true;
export async function getStaticPaths() {
	return productPaths(await loadShopContent());
}

const { shop, site, settings } = await loadShopPage(Astro);
const detail = productDetail(shop, Astro.params.slug ?? "");
if (!detail) return Astro.rewrite("/404");

const { entry, item } = detail;
const section = { href: `/collections/bikinis?category=${encodeURIComponent(item.category??'')}`, name: detail.categoryLabel??'Productos', label: detail.categoryLabel??'Producto' };
const choices = detail.kind === 'bundle'
 ? detail.components.map(component=>({name:`size_${component.item.id}`,legend:component.item.category === 'top' ? 'Talla del top' : 'Talla de la braguita',sizes:component.item.sizes}))
 : [{name:'talla',legend:'Talla',sizes:item.sizes}];
const production = settings?.data.production_text;
const names = item.card.transitionName ? transitionNames(item.card.transitionName) : null;
---

<Shop title={item.title} description={plainText(entry.data.description)} image={item.card.images[0]?.src} site={site}>
	<div class="wrapper region stack" style="--stack-space: var(--section-gap)">
		<div class="stack" style="--stack-space: var(--space-s)">
			<nav class="breadcrumb" aria-label="Ruta de navegación">
				<ol class="cluster" role="list">
					<li><a href="/collections/bikinis">Bikinis</a></li>
					<li><a href={section.href}>{section.name}</a></li>
					<li><span aria-current="page">{item.title}</span></li>
				</ol>
			</nav>
			<div class="split">
				<Gallery images={item.card.images} label={`Fotos de ${item.title}`} transitionName={names?.image} sheen={item.card.specialEdition}>
					<ProductBadges class="gallery__badges" specialEdition={item.card.specialEdition} />
				</Gallery>
				<div class="product-details stack">
					<div class="stack" style="--stack-space: var(--space-3xs)">
						<h1 class="product-details__title" style={names ? `view-transition-name: ${names.title}` : undefined}>{item.title}</h1>
						<p class="product-details__meta" style={names ? `view-transition-name: ${names.metadata}` : undefined}>{section.label}{detail.colorLabel && ` · color ${detail.colorLabel}`}</p>
					</div>
					<Price cents={item.price} transitionName={names?.price} />
					<div class="product-details__description stack" style="--stack-space: var(--space-xs)">
						<RichText value={entry.data.description} />
						{detail.kind === "bundle" && (
							<p class="product-details__includes">
								Incluye: {detail.components.map((piece, index) => (
									<>{index > 0 && " + "}<a href={piece.item.card.href}>{piece.item.title}</a></>
								))}
							</p>
						)}
					</div>
					<BuyBox id={item.id} slug={item.slug} priceCents={item.price} choices={choices} shipping={shippingRules(shop)} available={item.available}>
						{detail.sizeGuide && (
							<details class="size-guide" slot="size-guide">
								<summary class="size-guide__summary">Guía de tallas</summary>
								<div class="size-guide__body">
									<RichText value={detail.sizeGuide.data.content} />
								</div>
							</details>
						)}
					</BuyBox>
					{Array.isArray(production) && production.length > 0 && (
						<Disclosure title="Producción y envío">
							<RichText value={production} />
						</Disclosure>
					)}
				</div>
			</div>
		</div>

		{detail.related.length > 0 && (
			<section class="stack" aria-labelledby="related-title" style="--stack-space: var(--space-m-l)">
				<h2 id="related-title">También te puede gustar</h2>
				<ul class="grid" data-layout="products" role="list" style="--grid-columns: 4">
					{uniqueTransitions(detail.related.map((related) => related.card)).map((card) => <li><ProductCard product={card} /></li>)}
				</ul>
			</section>
		)}
	</div>
</Shop>
