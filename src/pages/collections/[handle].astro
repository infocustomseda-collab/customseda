---
// Catalog listings at retained Shopify paths: /collections/bikinis (everything), conjuntos, top, braguitas,
// and one view per CMS collection (e.g. margarita).
import CatalogBrowser from "../../components/CatalogBrowser.astro";
import RichText from "../../components/RichText.astro";
import Shop from "../../layouts/Shop.astro";
import { buildCatalog, catalogView, facetOptions } from "../../lib/shop/catalog";
import { loadShopPage } from "../../lib/shop/page";
import { plainText } from "../../lib/shop/site";

const { shop, site } = await loadShopPage(Astro);
const view = catalogView(Astro.params.handle ?? "", shop);
if (!view) return new Response(null, { status: 404 });
const items = view.items(buildCatalog(shop));
const facets = facetOptions(items, shop);
const tabs = [
	{ handle: "bikinis", label: "Todo" },
	{ handle: "conjuntos", label: "Conjuntos" },
	{ handle: "top", label: "Tops" },
	{ handle: "braguitas", label: "Braguitas" },
];
---

<Shop title={view.title} description={plainText(view.description) || `${view.title} de Seda`} site={site}>
	<div class="wrapper region stack" style="--stack-space: var(--space-m-l)">
		<header class="stack" style="--stack-space: var(--space-s)">
			<h1>{view.title}</h1>
			<RichText value={view.description} />
			<nav aria-label="Categorías">
				<ul class="cluster category-tabs" role="list">
					{tabs.map((tab) => (
						<li><a class="choice__label" href={`/collections/${tab.handle}`} aria-current={tab.handle === view.handle ? "page" : undefined}>{tab.label}</a></li>
					))}
				</ul>
			</nav>
		</header>

		{items.length > 0 ? (
			<CatalogBrowser items={items} colors={facets.colors} sizes={facets.sizes} />
		) : (
			<div class="catalog__empty stack text-center">
				<p>Todavía no hay piezas en esta sección. Vuelve pronto.</p>
				<p><a href="/collections/bikinis">Ver todos los bikinis</a></p>
			</div>
		)}
	</div>
</Shop>
