---
// Catalog listings at existing public paths: /collections/bikinis (everything), conjuntos, top, braguitas,
// and one view per CMS collection (e.g. margarita).
import CatalogBrowser from "../../components/CatalogBrowser.astro";
import RichText from "../../components/RichText.astro";
import Shop from "../../layouts/Shop.astro";
import { buildCatalog, catalogView, facetOptions } from "../../lib/shop/catalog";
import { loadShopContent, loadShopPage } from "../../lib/shop/page";
import { collectionPaths } from "../../lib/shop/paths";
import { plainText } from "../../lib/shop/site";

export const prerender = true;
export async function getStaticPaths() {
	return collectionPaths(await loadShopContent());
}

const { shop, site } = await loadShopPage(Astro);
const view = catalogView(Astro.params.handle ?? "", shop);
if (!view) return Astro.rewrite("/404");
// Retained category URLs initialize the same complete grid. Collection pages keep
// their collection scope; category selection is then another query refinement.
const legacyCategories = { bikinis: "todos", conjuntos: "conjuntos", top: "tops", braguitas: "braguitas" } as const;
const initialCategory = legacyCategories[view.handle as keyof typeof legacyCategories] ?? "todos";
const listing = view.handle in legacyCategories ? catalogView("bikinis", shop)! : view;
const basePath = `/collections/${listing.handle}`;
const catalog = buildCatalog(shop);
const items = listing.items(catalog);
const facets = facetOptions(items, shop);
const tabs = [
	{ category: "todos", label: "Todo" },
	{ category: "conjuntos", label: "Conjuntos" },
	{ category: "tops", label: "Tops" },
	{ category: "braguitas", label: "Braguitas" },
];
---

<Shop title={listing.title} description={plainText(listing.description) || `${listing.title} de Seda`} site={site}>
	<div class="catalog-page wrapper region stack" style="--stack-space: var(--space-m-l)">
		<header class="catalog-page__header stack" style="--stack-space: var(--space-s)">
			<h1>{listing.title}</h1>
			<RichText value={listing.description} />
			<nav aria-label="Categorías">
				<ul class="cluster category-tabs" role="list">
					{tabs.map((tab) => (
						<li><a class="category-tabs__link" data-category={tab.category} href={`${basePath}?category=${tab.category}`} aria-current={tab.category === initialCategory ? "true" : undefined}>{tab.label}</a></li>
					))}
				</ul>
			</nav>
		</header>

		{items.length > 0 ? (
			<CatalogBrowser items={items} colors={facets.colors} basePath={basePath} initialCategory={initialCategory} />
		) : (
			<div class="catalog__empty stack text-center">
				<p>Todavía no hay piezas en esta sección. Vuelve pronto.</p>
				<p><a href="/collections/bikinis">Ver todos los bikinis</a></p>
			</div>
		)}
	</div>
</Shop>
