---
// The CMS pages collection still builds `/<slug>` links (admin previews, older references); send those
// to the public /pages/<slug> path. Everything else is a 404.
import { loadShopPage } from "../lib/shop/page";

const { shop } = await loadShopPage(Astro);
const page = shop.pages.find((entry) => entry.slug === Astro.params.slug);
if (!page) return Astro.rewrite("/404");
const target = page.slug === "noticias" ? "/blogs/noticias" : page.slug.endsWith("-policy") ? `/policies/${page.slug}` : `/pages/${page.slug}`;
return Astro.redirect(target, 301);
---
