---
// The CMS pages collection still builds `/<slug>` links (admin previews, older references); send those
// to the public path. Prerendered as redirect pages; unknown slugs fall through to the 404.
import { loadShopContent } from "../lib/shop/page";
import { rootRedirectPaths, rootRedirectTarget } from "../lib/shop/paths";

export const prerender = true;
export async function getStaticPaths() {
	return rootRedirectPaths(await loadShopContent());
}

// Preview builds render on request and have no static props, so look the target up.
const target = (Astro.props as { target?: string }).target ?? rootRedirectTarget(await loadShopContent(), Astro.params.slug ?? "");
if (!target) return Astro.rewrite("/404");
return Astro.redirect(target, 301);
---
