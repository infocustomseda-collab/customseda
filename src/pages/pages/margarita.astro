---
// Margarita collection story, from the editable "margarita" page (retained Shopify path).
import StoryContent from "../../components/StoryContent.astro";
import Shop from "../../layouts/Shop.astro";
import { loadShopPage } from "../../lib/shop/page";
import { plainText } from "../../lib/shop/site";

export const prerender = true;

const { shop, site } = await loadShopPage(Astro);
const page = shop.pages.find((entry) => entry.slug === "margarita");
if (!page) return Astro.rewrite("/404");
const title = typeof page.data.title === "string" ? page.data.title : "Margarita";
---

<Shop title={title} description={plainText(page.data.content)} site={site}>
	<article class="wrapper region">
		<h1 class="visually-hidden">{title}</h1>
		<StoryContent value={page.data.content} />
	</article>
</Shop>
