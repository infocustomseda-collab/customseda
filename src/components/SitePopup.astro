---
// Editable promotional popups in native modal dialogs: focus moves in and is trapped, Escape and the close
// button dismiss, and focus returns to the page. Every candidate is rendered; the browser opens the first
// one inside its schedule and not dismissed within its dismissal period.
import type { PopupView } from "../lib/shop/site";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import RichText from "./RichText.astro";

interface Props {
	popups: PopupView[];
}

const { popups } = Astro.props;
---

<site-popups data-schedules={JSON.stringify(popups.map((popup) => ({ ...popup.schedule, delaySeconds: popup.delaySeconds })))}>
	{popups.map((popup) => (
		<dialog class="popup" data-popup={popup.id} aria-labelledby={`popup-title-${popup.id}`}>
			<button class="popup__close icon-button" type="button" data-close aria-label="Cerrar">
				<Icon name="close" />
			</button>
			{popup.image && (
				<img class="popup__image" src={popup.image.src} srcset={popup.image.srcset} sizes="(min-width: 40em) 30rem, 90vw" alt={popup.image.alt} width={popup.image.width} height={popup.image.height} loading="lazy" decoding="async" />
			)}
			<div class="popup__body stack text-center">
				<h2 class="popup__title" id={`popup-title-${popup.id}`}>{popup.title}</h2>
				<RichText value={popup.content} />
				{popup.button && <Button href={popup.button.href} variant="accent" data-close>{popup.button.label}</Button>}
			</div>
		</dialog>
	))}
</site-popups>

<script>
	import { choosePopup, popupStorageKey, type PopupSchedule } from "../lib/shop/popup";

	const stored = (id: string) => {
		try {
			const value = Number(localStorage.getItem(popupStorageKey(id)));
			return value > 0 ? value : null;
		} catch {
			return null; // Storage blocked: show at most once per page view.
		}
	};

	class SitePopups extends HTMLElement {
		connectedCallback() {
			const schedules = JSON.parse(this.dataset.schedules || "[]") as (PopupSchedule & { delaySeconds: number })[];
			const chosen = choosePopup(schedules, Date.now(), stored) as (PopupSchedule & { delaySeconds: number }) | null;
			if (!chosen) return;
			const dialog = [...this.querySelectorAll("dialog")].find((element) => element.dataset.popup === chosen.id) as HTMLDialogElement | undefined;
			if (!dialog) return;
			dialog.addEventListener("close", () => {
				try {
					localStorage.setItem(popupStorageKey(chosen.id), String(Date.now()));
				} catch {}
			});
			for (const control of dialog.querySelectorAll("[data-close]")) control.addEventListener("click", () => dialog.close());
			// A click on the backdrop (the dialog box itself, outside its content) dismisses it.
			dialog.addEventListener("click", (event) => {
				if (event.target === dialog) dialog.close();
			});
			window.setTimeout(() => {
				if (!dialog.open && !document.querySelector("dialog[open], :popover-open")) dialog.showModal();
			}, chosen.delaySeconds * 1000);
		}
	}
	if (!customElements.get("site-popups")) customElements.define("site-popups", SitePopups);
</script>
