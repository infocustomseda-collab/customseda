---
// Portable Text link mark: old-storefront links become site paths; unsafe schemes render as text.
import { linkHref } from "../../lib/shop/site";

interface Props {
	node: { markDef: { href?: string; blank?: boolean } };
}

const href = linkHref(Astro.props.node?.markDef?.href);
const external = href?.startsWith("http");
---

{href ? <a href={href} rel={external ? "noopener" : undefined} target={external ? "_blank" : undefined}><slot /></a> : <slot />}
