---
// Progressive enhancement: all cards remain browsable without JavaScript.
import { filterItems, type CatalogItem, type Category } from "../lib/shop/catalog";
import { uniqueTransitions } from "../lib/shop/view";
import Icon from "./Icon.astro";
import ProductCard from "./ProductCard.astro";

interface Props {
	items: CatalogItem[];
	colors: { slug: string; label: string }[];
	basePath: string;
	initialCategory: Category;
}
const { items, colors, basePath, initialCategory } = Astro.props;
const initialItems = new Set(filterItems(items, { category: initialCategory, colors: [], available: false }).map(item => item.id));
const data = items.map(({ card: _card, ...item }) => item);
const cards = uniqueTransitions(items.map((item) => item.card));
const count = (n: number) => `${n} ${n === 1 ? "producto" : "productos"}`;
---

<catalog-browser class="catalog" data-base-path={basePath} data-initial-category={initialCategory}>
	<div class="catalog__tools" data-enhanced hidden>
		<div class="catalog__toolbar">
			<button class="filters__toggle" type="button" aria-expanded="false" aria-controls="catalog-filter-panel"><span data-filter-label>Filtrar</span><Icon name="chevron-down" /></button>
			<p class="catalog__count" aria-live="polite" data-count>{count(initialItems.size)}</p>
			<label class="catalog__sort">
				<span class="visually-hidden">Ordenar por</span>
				<select name="orden" form="catalog-filters">
					<option value="destacados">Destacados</option>
					<option value="precio-asc">Precio: menor a mayor</option>
					<option value="precio-desc">Precio: mayor a menor</option>
					<option value="nombre">Nombre</option>
				</select>
			</label>
		</div>
		<div class="filters__panel" id="catalog-filter-panel" inert>
			<div class="filters__clip">
				<form class="filters" id="catalog-filters" aria-label="Filtros">
					{colors.length > 0 && (
						<fieldset class="choice-group">
							<legend class="choice-group__legend">Color</legend>
							<div class="choice-group__options cluster">
								{colors.map(color => (
									<label class="choice">
										<input class="choice__input" type="checkbox" name="color" value={color.slug} data-label={color.label} />
										<span class="choice__label">{color.label}</span>
									</label>
								))}
							</div>
						</fieldset>
					)}
					<label class="filters__availability">
						<input type="checkbox" name="disponible" value="1" data-label="Solo disponibles" />
						<span>Solo disponibles</span>
					</label>
				</form>
			</div>
		</div>
	</div>
	<div class="catalog__active cluster" data-active hidden>
		<div class="cluster" data-selected role="group" aria-label="Filtros seleccionados"></div>
		<button class="filters__clear" type="button" data-clear>Quitar filtros</button>
	</div>
	<ul class="grid" data-layout="products" role="list" data-grid>
		{items.map((item, index) => (
			<li data-id={item.id} hidden={!initialItems.has(item.id)}><ProductCard product={cards[index]} eager={index < 3} headingLevel={2} /></li>
		))}
	</ul>
	<div class="catalog__empty stack text-center" data-empty hidden>
		<p>Ninguna pieza coincide con estos filtros.</p>
		<button class="button" data-variant="secondary" type="button" data-clear>Quitar filtros</button>
	</div>
	<template data-remove-icon><Icon name="close" size={14} /></template>
	<script type="application/json" data-items set:html={JSON.stringify(data).replaceAll("<", "\\u003c")} />
</catalog-browser>

<script>
	import { CatalogGridMotion } from "../lib/shop/catalog-motion";
	import { categoryHref, filterItems, filtersQuery, parseFilters, sortItems, type CatalogItem, type Category } from "../lib/shop/filters";
	class CatalogBrowser extends HTMLElement {
		controller?: AbortController;
		motion?: CatalogGridMotion;
		connectedCallback() {
			this.controller?.abort();
			this.motion?.cancel();
			this.controller = new AbortController();
			const { signal } = this.controller;
			const items = JSON.parse(this.querySelector("[data-items]")!.textContent || "[]") as CatalogItem[];
			const form = this.querySelector<HTMLFormElement>("form")!;
			const grid = this.querySelector<HTMLElement>("[data-grid]")!;
			const cards = new Map([...grid.children].map(li => [(li as HTMLElement).dataset.id!, li as HTMLElement]));
			const style = getComputedStyle(grid);
			const duration = (name: string) => {
				const value = style.getPropertyValue(name).trim();
				return parseFloat(value) * (value.endsWith("ms") ? 1 : 1000);
			};
			const motion = this.motion = new CatalogGridMotion(grid, cards, {
				exit: duration("--duration-quick"), move: duration("--duration-slow"),
				enter: duration("--duration-moderate"), easing: style.getPropertyValue("--ease-out").trim(),
			});
			const empty = this.querySelector<HTMLElement>("[data-empty]")!;
			const counter = this.querySelector<HTMLElement>("[data-count]")!;
			const tools = this.querySelector<HTMLElement>(".catalog__tools")!;
			const panel = this.querySelector<HTMLElement>(".filters__panel")!;
			const toggle = this.querySelector<HTMLButtonElement>(".filters__toggle")!;
			const setFiltersOpen = (open: boolean) => {
				toggle.setAttribute("aria-expanded", String(open));
				panel.toggleAttribute("data-open", open);
				panel.inert = !open;
			};
			toggle.addEventListener("click", () => setFiltersOpen(toggle.getAttribute("aria-expanded") !== "true"), { signal });
			const filterLabel = this.querySelector<HTMLElement>("[data-filter-label]")!;
			const active = this.querySelector<HTMLElement>("[data-active]")!;
			const selected = this.querySelector<HTMLElement>("[data-selected]")!;
			const removeIcon = this.querySelector<HTMLTemplateElement>("[data-remove-icon]")!;
			const sort = this.querySelector("select") as HTMLSelectElement;
			const inputs = [...form.querySelectorAll<HTMLInputElement>("input")];
			const colors = [...new Set(items.flatMap(item => item.color ? [item.color] : []))];
			const basePath = this.dataset.basePath!;
			const links = [...this.closest(".catalog-page")!.querySelectorAll<HTMLAnchorElement>("[data-category]")];
			let category: Category = "";
			const restore = (defaultCategory: Category = "") => {
				const state = parseFilters(location.search, { colors, categories: links.map(link=>link.dataset.category!), defaultCategory });
				category = state.category;
				for (const input of inputs) input.checked = input.name === "color" ? state.colors.includes(input.value) : state.available;
				sort.value = state.sort;
			};
			const apply = (historyMode: "replace" | "push" | "none" = "replace", animate = true) => {
				const filters = { ...parseFilters(`?${new URLSearchParams(new FormData(form) as unknown as Record<string, string>)}`, { colors }), category };
				const visible = sortItems(filterItems(items, filters), filters.sort);
				const shown = new Set(visible.map(item => item.id));

				counter.textContent = `${visible.length} ${visible.length === 1 ? "producto" : "productos"}`;
				empty.hidden = visible.length > 0;
				if (historyMode !== "none") {
					const href = `${basePath}${filtersQuery(filters)}${location.hash}`;
					if (historyMode === "push" && href !== `${location.pathname}${location.search}${location.hash}`) history.pushState({ ...history.state, sedaCatalog: true }, "", href);
					else history.replaceState({ ...history.state, sedaCatalog: true }, "", href);
				}
				for (const link of links) {
					link.href = categoryHref(basePath, filters, link.dataset.category as Category);
					if (link.dataset.category === category) link.setAttribute("aria-current", "true");
					else link.removeAttribute("aria-current");
				}
				const checked = inputs.filter(input => input.checked);
				filterLabel.textContent = checked.length ? `Filtros (${checked.length})` : "Filtrar";
				active.hidden = checked.length === 0;
				selected.replaceChildren();
				for (const input of checked) {
					const button = document.createElement("button");
					button.type = "button";
					button.className = "filters__selected";
					button.textContent = input.dataset.label || input.value;
					button.setAttribute("aria-label", `Quitar filtro: ${button.textContent}`);
					button.appendChild(removeIcon.content.cloneNode(true));
					button.addEventListener("click", () => {
						const index = [...selected.children].indexOf(button);
						input.checked = false;
						apply();
						// Removing a focused chip must leave keyboard users at a useful control.
						((selected.children[Math.min(index, selected.children.length - 1)] as HTMLElement) || toggle).focus();
					});
					selected.appendChild(button);
				}
				motion.update([...shown], animate && !matchMedia("(prefers-reduced-motion: reduce)").matches);
			};
			for (const link of links) link.addEventListener("click", event => {
				if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				event.stopPropagation(); // Category changes belong to this grid, not ClientRouter.
				category = link.dataset.category as Category;
				setFiltersOpen(false);
				apply("push");
			}, { signal });
			this.addEventListener("seda:catalog-history", () => {
				if (location.pathname !== basePath) return;
				restore();
				apply("none");
			}, { signal });
			form.addEventListener("submit", event => event.preventDefault(), { signal });
			form.addEventListener("change", () => apply(), { signal });
			sort.addEventListener("change", () => apply(), { signal });
			for (const button of this.querySelectorAll<HTMLButtonElement>("[data-clear]")) button.addEventListener("click", () => {
				inputs.forEach(input => input.checked = false);
				apply();
				toggle.focus();
			}, { signal });
			tools.addEventListener("keydown", event => {
				if (event.key === "Escape") { setFiltersOpen(false); toggle.focus(); }
			}, { signal });
			for (const element of this.querySelectorAll<HTMLElement>("[data-enhanced]")) element.hidden = false;
			// connectedCallback can run during a body swap, before Astro updates the
			// address bar. Initialize only once the destination URL is in place.
			document.addEventListener("astro:page-load", () => {
				restore(this.dataset.initialCategory as Category);
				apply("replace", false);
			}, { signal });
		}
		disconnectedCallback() { this.controller?.abort(); this.motion?.cancel(); }
	}
	if (!customElements.get("catalog-browser")) customElements.define("catalog-browser", CatalogBrowser);
</script>
