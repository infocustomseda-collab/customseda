---
// Catalog card: 4:5 photo with second-image hover swap, centered title and price.
import { transitionNames, type ProductCardView } from "../lib/shop/view";
import Price from "./Price.astro";

interface Props {
	product: ProductCardView;
	headingLevel?: 2 | 3;
	eager?: boolean;
}

const { product, headingLevel = 3, eager = false } = Astro.props;
const names = product.transitionName ? transitionNames(product.transitionName) : null;
const [main, hover] = product.images;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<article class="product-card">
	<div class="product-card__media" style={main?.placeholder ? `background-color: ${main.placeholder}` : undefined}>
		{main && (
			<img
				src={main.src}
				srcset={main.srcset}
				sizes="(min-width: 60em) 25vw, 50vw"
				alt={main.alt}
				width={main.width}
				height={main.height}
				style={`object-position: ${main.position}${names ? `; view-transition-name: ${names.image}` : ""}`}
				loading={eager ? "eager" : "lazy"}
				fetchpriority={eager ? "high" : undefined}
				decoding="async"
			/>
		)}
		{hover && (
			<img src={hover.src} srcset={hover.srcset} sizes="(min-width: 60em) 25vw, 50vw" alt="" width={hover.width} height={hover.height} style={`object-position: ${hover.position}`} loading="lazy" decoding="async" />
		)}
		{!product.available && <span class="product-card__badge badge">No disponible</span>}
	</div>
	<div class="product-card__details">
	<Heading class="product-card__title">
		<a class="product-card__link" href={product.href} style={names ? `view-transition-name: ${names.title}` : undefined}>{product.title}</a>
	</Heading>
	{product.metadata && <p class="product-card__metadata">{product.metadata}</p>}
	<Price cents={product.priceCents} size="small" />
	</div>
</article>
