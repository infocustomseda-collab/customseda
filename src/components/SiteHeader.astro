---
// Centered wordmark with cart on the right; nav row on wide screens, popover drawer on small ones.
// The cart arrives in phase 8 (buy-now checkout until then), so its link renders only when given.
import type { NavItem } from "../lib/shop/view";
import Icon from "./Icon.astro";

interface Props {
	nav: NavItem[];
	cartHref?: string;
}

const { nav, cartHref } = Astro.props;
---

<header class="site-header">
	<div class="site-header__bar wrapper">
		<div class="site-header__start">
			<button class="site-header__menu-toggle icon-button" type="button" popovertarget="nav-drawer" aria-label="Abrir menú">
				<Icon name="menu" />
			</button>
		</div>
		<a class="site-header__logo" href="/">
			<img src="/brand/seda-wordmark.png" alt="Seda — inicio" width="480" height="225" />
		</a>
		<div class="site-header__end">
			{cartHref && (
				<a class="icon-button" href={cartHref} aria-label="Carrito">
					<Icon name="bag" />
					<span class="icon-button__count" data-cart-count></span>
				</a>
			)}
		</div>
	</div>
	<nav class="site-nav" aria-label="Principal">
		<ul class="site-nav__list cluster" role="list">
			{nav.map((item) => (
				<li><a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a></li>
			))}
		</ul>
	</nav>
</header>

<div class="nav-drawer" id="nav-drawer" popover>
	<button class="nav-drawer__close icon-button" type="button" popovertarget="nav-drawer" popovertargetaction="hide" aria-label="Cerrar menú">
		<Icon name="close" />
	</button>
	<nav aria-label="Principal">
		<ul class="nav-drawer__list stack" role="list" style="--stack-space: var(--space-s)">
			{nav.map((item) => (
				<li><a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a></li>
			))}
		</ul>
	</nav>
</div>
